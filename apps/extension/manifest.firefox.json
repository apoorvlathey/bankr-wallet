{
  "name": "WalletChan",
  "version": "3.17.0",
  "manifest_version": 3,
  "description": "WalletChan",
  "homepage_url": "https://walletchan.eth.sh",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@walletchan",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "WalletChan",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "static/js/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "file://*/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "static/js/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "static/js/inpage.js",
        "walletchan-animated.gif",
        "walletchan-icon.png",
        "walletchan-icon-white-bg.png"
      ],
      "matches": [
        "file://*/*",
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}

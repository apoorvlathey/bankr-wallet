# Optional. Defaults to http://127.0.0.1:4209.
WALLETCHAN_RPC_URL=http://127.0.0.1:4209

# Optional. First-party WalletChan API base for portfolio, swap, and bridge tools.
# Defaults to https://walletchan.com/api.
WALLETCHAN_MCP_API_BASE=https://walletchan.com/api

# Optional. Defaults to true. Set to false to use an already running walletchan-rpc.
WALLETCHAN_MCP_MANAGED_RPC=true

# Optional comma-separated chain names/IDs for the managed walletchan-rpc.
WALLETCHAN_MCP_CHAINS=base

# Optional comma-separated upstream RPC overrides for managed walletchan-rpc.
# Format: chain=url, e.g. base=https://base.drpc.org
WALLETCHAN_MCP_RPC_OVERRIDES=

# Optional WalletConnect project ID override for managed walletchan-rpc.
WALLETCHAN_MCP_WALLETCONNECT_PROJECT_ID=

# Optional. Defaults to true. Set to false to disable allowlisted protocol HTTP calls.
WALLETCHAN_MCP_WEB_REQUEST=true

# Optional comma-separated extra HTTPS hosts for web_request.
# Default hosts cover current HTTP-based Base plugins: Morpho, Moonwell,
# Uniswap, Avantis, Bankr discovery, and walletchan-rpc default upstream RPCs.
WALLETCHAN_MCP_WEB_HOSTS=

# Optional. Defaults to true. Set to false to disable pinned protocol CLI runners.
WALLETCHAN_MCP_PLUGIN_CLI=true

# Optional Morpho API endpoint override. Must be https://api.morpho.org/... or
# https://blue-api.morpho.org/...
WALLETCHAN_MCP_MORPHO_API_URL=

# Optional Aerodrome Sugar SDK Base RPC override.
# Defaults to walletchan-rpc's Base default: https://base.drpc.org.
WALLETCHAN_MCP_AERODROME_RPC_URL=

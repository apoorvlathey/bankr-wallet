# Server-only Pimlico credential used by /api/gas/pimlico/[chainId].
# Never expose this value through NEXT_PUBLIC_* or extension build variables.
PIMLICO_API_KEY=

# Emergency kill switch for all token-paid gas requests.
PIMLICO_PROXY_DISABLED=false

# Railway domain-reputation service. Keep the token server-only and identical
# to DOMAIN_REPUTATION_SERVICE_TOKEN on the Railway service.
DOMAIN_REPUTATION_SERVICE_URL=https://your-service.up.railway.app
DOMAIN_REPUTATION_SERVICE_TOKEN=
